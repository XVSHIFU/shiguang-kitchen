# 将此文件复制为项目根目录 .env。启动脚本也可自动创建它。
# 默认使用 backend/data/app.db。数据库路径可按部署目录配置。
# DATA_DIR=backend/data
# DATABASE_URL=sqlite:///backend/data/app.db
# PostgreSQL 换餐审批可保存 LangGraph 检查点。使用现有的 PostgreSQL 数据库和账号。
# DATABASE_URL=postgresql+psycopg://ai_life:replace-with-db-password@127.0.0.1:5432/ai_life

# 留空时使用规则模式。填入提供方所分配的 API 密钥和实际模型名称。
MODEL_API_KEY=
MODEL_BASE_URL=https://api.deepseek.com
MODEL_NAME=deepseek-flash
MODEL_VISION_NAME=

# 可选的部署配置
EXPIRY_WARN_DAYS=3
# SECRET_KEY=replace-with-a-random-local-value
# POSTGRES_USER=ai_life
# POSTGRES_DB=ai_life
# POSTGRES_PASSWORD=replace-with-a-deployment-password
